<Page x:Class="Biblioteca.WPF.Views.DevolucionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Devolución"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="40,32,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="MOSTRADOR" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Devolución" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="txtSubtitulo" Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Rule}" Margin="0,18,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SOCIO" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="cboSocios" HorizontalAlignment="Stretch"
                              IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Nombre"
                              SelectionChanged="cboSocios_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DNI}" Width="90"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Nombre}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="LIBROS PENDIENTES" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                    <TextBlock x:Name="txtPendientes" Text="–" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Libros por devolver" Margin="4,0,0,12"
                               Style="{StaticResource SectionTitle}" />

                    <DataGrid x:Name="dgPendientes" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgPendientes_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Libro" Binding="{Binding LibroTitulo}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Préstamo" Binding="{Binding PrestamoId, StringFormat='N° {0}'}"
                                                Width="90" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}"
                                                Width="110" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Retraso (días)" Binding="{Binding DiasRetraso}"
                                                Width="110" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Multa" Binding="{Binding MultaTexto}"
                                                Width="90" FontWeight="SemiBold"
                                                ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="estadoVacio" Grid.Row="1" Style="{StaticResource EmptyState}"
                                Visibility="Visible">
                        <TextBlock x:Name="txtVacio" Text="Seleccione un socio para ver sus libros pendientes."
                                   FontFamily="Georgia" FontStyle="Italic" FontSize="16"
                                   HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <ui:ProgressRing x:Name="anilloCarga" Grid.Row="1" IsIndeterminate="True"
                                     Width="40" Height="40" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Registrar devolución" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Elija el libro en la tabla." Style="{StaticResource HintText}"
                               Margin="0,4,0,0" />
                    <Border Style="{StaticResource Rule}" Margin="0,14,0,0" />

                    <TextBlock Text="LIBRO" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="txtLibro" Text="–" TextWrapping="Wrap" FontFamily="Georgia" FontSize="16" />

                    <TextBlock Text="FECHA LÍMITE" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="txtLimite" Text="–" />

                    <TextBlock Text="DÍAS DE RETRASO" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="txtRetraso" Text="–" />

                    <Border x:Name="panelMulta" Margin="0,22,0,0" Padding="14,4,0,4"
                            BorderBrush="{StaticResource GoldBrush}" BorderThickness="3,0,0,0">
                        <StackPanel>
                            <TextBlock Text="MULTA A COBRAR" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                            <TextBlock x:Name="txtMulta" Text="S/ 0.00" FontFamily="Georgia" FontSize="32"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="txtTarifa" Style="{StaticResource HintText}" />
                        </StackPanel>
                    </Border>

                    <ui:Button x:Name="btnDevolver" Content="Registrar devolución" Margin="0,22,0,0"
                               HorizontalAlignment="Stretch" Appearance="Primary" Click="btnDevolver_Click" />

                    <Border x:Name="panelResultado" Margin="0,16,0,0" Padding="14,12" CornerRadius="3"
                            Background="{StaticResource SuccessSoftBrush}" Visibility="Collapsed">
                        <TextBlock x:Name="txtResultado" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
