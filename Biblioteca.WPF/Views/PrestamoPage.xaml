<Page x:Class="Biblioteca.WPF.Views.PrestamoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Préstamo"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="40,32,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="MOSTRADOR" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Nuevo préstamo" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Elija un socio y agregue uno o varios libros. Cada socio puede tener hasta 3 libros pendientes a la vez."
                       Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Rule}" Margin="0,18,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SOCIO" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="cboSocios" HorizontalAlignment="Stretch"
                              IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Nombre"
                              SelectionChanged="cboSocios_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DNI}" Width="90"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Nombre}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="LIBROS PENDIENTES" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBlock x:Name="txtPendientes" Text="–" Style="{StaticResource StatValue}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="DEVOLVER ANTES DEL" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBlock x:Name="txtFechaLimite" Text="–" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Libros del préstamo" Margin="4,0,0,12"
                               Style="{StaticResource SectionTitle}" />

                    <DataGrid x:Name="dgLibros" Grid.Row="1" Style="{StaticResource ModernGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding AutorNombre}" Width="2*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="130"
                                                ElementStyle="{StaticResource TextCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="estadoVacio" Grid.Row="1" Style="{StaticResource EmptyState}"
                                Visibility="Visible">
                        <TextBlock Text="Agregue libros con el panel de la derecha." FontFamily="Georgia"
                                   FontStyle="Italic" FontSize="16" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <ui:ProgressRing x:Name="anilloCarga" Grid.Row="1" IsIndeterminate="True"
                                     Width="40" Height="40" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Agregar libro" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Solo aparecen libros con ejemplares disponibles."
                               Style="{StaticResource HintText}" Margin="0,4,0,0" />
                    <Border Style="{StaticResource Rule}" Margin="0,14,0,0" />

                    <TextBlock Text="LIBRO" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="cboLibros" HorizontalAlignment="Stretch"
                              IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Titulo">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}" />
                                    <TextBlock Style="{StaticResource HintText}">
                                        <Run Text="{Binding AutorNombre, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Ejemplares, Mode=OneWay}" />
                                        <Run Text=" disp." />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnAgregar" Grid.Column="0" Content="Agregar" HorizontalAlignment="Stretch"
                                   Click="btnAgregar_Click" />
                        <ui:Button x:Name="btnQuitar" Grid.Column="2" Content="Quitar" HorizontalAlignment="Stretch"
                                   ToolTip="Quita el libro seleccionado de la lista" Click="btnQuitar_Click" />
                    </Grid>

                    <Border Margin="0,22,0,0" Padding="14,4,0,4" BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="3,0,0,0">
                        <StackPanel>
                            <TextBlock Text="LIBROS EN ESTE PRÉSTAMO" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,2" />
                            <TextBlock x:Name="txtCantidad" Text="0" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>

                    <ui:Button x:Name="btnRegistrar" Content="Registrar préstamo" Margin="0,22,0,0"
                               HorizontalAlignment="Stretch" Appearance="Primary" Click="btnRegistrar_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
