<Page x:Class="Biblioteca.WPF.Views.ReportePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Reporte"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="40,32,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="REGISTRO" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Reporte de préstamos" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Consulte los préstamos de un intervalo de fechas: socio, libros, fecha límite y estado."
                       Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Rule}" Margin="0,18,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="DESDE" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <DatePicker x:Name="dpDesde" Width="160" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="HASTA" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <DatePicker x:Name="dpHasta" Width="160" SelectedDateFormat="Short" />
                </StackPanel>
                <ui:Button x:Name="btnBuscar" Grid.Column="2" Content="Generar reporte" VerticalAlignment="Bottom"
                           Appearance="Primary" Click="btnBuscar_Click" />

                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="RESULTADO" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right"
                               Margin="0,0,0,2" />
                    <TextBlock x:Name="txtResumen" Text="–" FontFamily="Georgia" FontSize="18"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="18">
            <Grid>
                <DataGrid x:Name="dgReporte" Style="{StaticResource ModernGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Préstamo" Binding="{Binding PrestamoId, StringFormat='N° {0}'}"
                                            Width="86" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Socio" Binding="{Binding SocioNombre}" Width="2*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Libro" Binding="{Binding LibroTitulo}" Width="3*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Préstamo el" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}"
                                            Width="100" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}"
                                            Width="100" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Devuelto el"
                                            Binding="{Binding FechaDevolucion, StringFormat=dd/MM/yyyy, TargetNullValue=—}"
                                            Width="100" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTemplateColumn Header="Estado" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}">
                                        <TextBlock Style="{StaticResource StatusPillText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="estadoVacio" Style="{StaticResource EmptyState}">
                    <TextBlock Text="No hay préstamos en ese intervalo de fechas." FontFamily="Georgia"
                               FontStyle="Italic" FontSize="16" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <ui:ProgressRing x:Name="anilloCarga" IsIndeterminate="True"
                                 Width="40" Height="40" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
